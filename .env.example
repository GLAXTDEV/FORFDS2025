# Port fourni par la plupart des hebergeurs
PORT=3000

# Chemin vers un disque persistant pour conserver les messages
DB_PATH=./message.sqlite

# Cle privee de l'administrateur principal
ADMIN_KEY=remplacez-cette-valeur

# Origines autorisees si le frontend est heberge sur un domaine different
# Plusieurs domaines peuvent etre separes par des virgules
CORS_ORIGIN=https://votre-frontend.example.com

# Si le frontend et l'API sont separes, ajoutez dans index.html avant les scripts :
# <script>window.DOCS_API_URL = 'https://votre-api.example.com';</script>
